---
import { Mail } from '@lucide/astro';
import { Github } from 'simple-icons-astro';
import DefaultLayout from '../layouts/DefaultLayout.astro';
import { getLocale, messages } from '../i18n';
import { contact, email, githubUrl } from '../i18n/contact';
import '../styles/contact.css';

const locale = getLocale(Astro.currentLocale);
const t = messages[locale];
const content = contact[locale];
---

<DefaultLayout>
    <h1>{t.contact}</h1>

    <p class="lead">{content.intro}</p>

    <div class="contact-grid">
        <a href={`mailto:${email}`} class="card contact-card">
            <Mail class="card__icon" />
            <h2>{content.emailTitle}</h2>
            <p>{content.emailText}</p>
            <span class="contact-card__value">{email}</span>
        </a>

        <a href={githubUrl} target="_blank" rel="noreferrer" class="card contact-card">
            <Github size={24} class="card__icon" />
            <h2>GitHub</h2>
            <p>{content.githubText}</p>
            <span class="contact-card__value">github.com/KaTo3107</span>
        </a>
    </div>
</DefaultLayout>
