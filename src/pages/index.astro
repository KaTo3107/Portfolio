---
import { Github } from 'simple-icons-astro'
import DefaultLayout from "../layouts/DefaultLayout.astro";
import { getLocale, localizePath, messages } from "../i18n";
import "../styles/index.css";

const locale = getLocale(Astro.currentLocale);
const t = messages[locale];
---

<DefaultLayout>
	<section class="hero">
		<div class="hero-copy">
			<p class="eyebrow">SOFTWARE DEVELOPER</p>

			<h1>{t.heroGreeting} <br />
				Tobias Karmann <br />
			</h1>

			<p class="lead">
				{t.heroLead}
			</p>

			<div class="hero-actions">
				<a href={localizePath('/projects', locale)} class="btn btn-primary">{t.heroCta}</a>
				<a
					href="https://github.com/KaTo3107"
					target="_blank"
					rel="noreferrer"
					class="btn btn-secondary">
					<Github size={25} />
					GitHub
				</a>
			</div>
		</div>
	</section>
</DefaultLayout>
