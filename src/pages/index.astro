---
import { ExternalLink, ArrowRight } from "@lucide/astro";
import { Github } from 'simple-icons-astro'
import DefaultLayout from "../layouts/DefaultLayout.astro";
import "../styles/index.css";
---

<DefaultLayout>
	<section class="hero">
		<div class="hero-copy">
			<p class="eyebrow">SOFTWARE DEVELOPER</p>

			<h1>Hi, ich bin <br /> 
				Tobias Karmann <br />
			</h1>

			<p class="lead">
				Ich löse gerne Probleme, bei denen ich bestehnde Abläufe verstehen, verbessern oder automatisieren kann.
			</p>

			<div class="hero-actions">
				<a href="/projects" class="btn btn-primary">Projekte ansehen</a>
				<a
					href="https://github.com/KaTo3107"
					target="_blank"
					rel="noreferrer"
					class="btn btn-secondary">
					<Github size={25} />
					GitHub
				</a>
			</div>
		</div>
	</section>
</DefaultLayout>
