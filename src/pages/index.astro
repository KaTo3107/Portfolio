---
import { Server, Workflow } from '@lucide/astro';
import { Github } from 'simple-icons-astro'
import OpenToWork from "../components/OpenToWork.astro";
import { siteConfig } from "../config";
import DefaultLayout from "../layouts/DefaultLayout.astro";
import { getLocale, localizePath, messages } from "../i18n";
import { home } from "../i18n/home";
import "../styles/index.css";

const locale = getLocale(Astro.currentLocale);
const t = messages[locale];
const content = home[locale];

const focusIcons = [Server, Workflow];

const codeSample = `var developer = new Developer
{
    Name = "Tobias Karmann",
    Stack = ["C#", ".NET", "ASP.NET"],
    Enjoys = "${content.codeEnjoys}"
};`;
---

<DefaultLayout>
	<section class="hero">
		<div class="hero-copy">
			<OpenToWork />

			<p class="eyebrow">{content.eyebrow}</p>

			<h1>{t.heroGreeting} <br />
				Tobias Karmann <br />
			</h1>

			<p class="lead">
				{t.heroLead}
			</p>

			<div class="hero-actions">
				<a href={localizePath('/projects', locale)} class="btn btn-primary">{t.heroCta}</a>
				<a
					href={siteConfig.githubUrl}
					target="_blank"
					rel="noreferrer"
					class="btn btn-secondary">
					<Github size={25} />
					GitHub
				</a>
			</div>
		</div>

		<pre class="hero-code" aria-hidden="true"><code>{codeSample}</code></pre>
	</section>

	<section class="home-section">
		<h2>{content.focusTitle}</h2>
		<ul class="focus-grid">
			{content.focusAreas.map((area, index) => {
				const Icon = focusIcons[index];
				return (
					<li class="card">
						<Icon class="card__icon" />
						<h3>{area.title}</h3>
						<p>{area.text}</p>
					</li>
				);
			})}
		</ul>
	</section>
</DefaultLayout>
