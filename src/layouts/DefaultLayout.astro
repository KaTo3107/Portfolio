---
import Navbar from '../components/Navbar.astro';
import { getLocale, localizePath, locales, messages, stripLocale } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const currentPath = stripLocale(Astro.url.pathname);
---

<html lang={locale} data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			(() => {
				let theme = null;
				try {
					theme = localStorage.getItem('theme');
				} catch {}
				if (theme !== 'light' && theme !== 'dark') {
					theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
				}
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		{locales.map((item) => (
			<link rel="alternate" hreflang={item} href={new URL(localizePath(currentPath, item), Astro.site)} />
		))}
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{messages[locale].title}</title>
		<slot name="head" />
	</head>
	<body>
		<div class="container">
			<header>
				<Navbar />
			</header>
			<div class="content">
        		<slot />
			</div>
		</div>
	</body>
</html>
