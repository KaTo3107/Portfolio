---
import { Menu, Moon, Sun, X } from "@lucide/astro";
import { getLocale, localizePath, locales, messages, stripLocale } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const t = messages[locale];
const currentPath = stripLocale(Astro.url.pathname);

const navItems = [
  { path: '/', label: t.home },
  { path: '/aboutme', label: t.about },
  { path: '/projects', label: t.projects },
  { path: '/contact', label: t.contact }
];
---

<nav aria-label={t.navLabel}>
  <a href={localizePath('/', locale)} class="logo" aria-label={t.logoLabel}>
    KaTo<span class="logo__dot" aria-hidden="true"></span>
  </a>

  <ul class="nav-list" id="nav-list">
    {navItems.map((item) => {
      const isActive = currentPath === item.path;
      return (
        <li>
          <a
            href={localizePath(item.path, locale)}
            aria-current={isActive ? 'page' : undefined}
            class={isActive ? 'active' : ''}
          >
            {item.label}
          </a>
        </li>
      );
    })}
  </ul>

  <div class="nav-actions">
    <div class="language-toggle" role="group" aria-label={t.languageLabel}>
      {locales.map((item) => (
        <a
          href={localizePath(currentPath, item)}
          hreflang={item}
          lang={item}
          class:list={['language-btn', { active: item === locale }]}
          aria-current={item === locale ? 'true' : undefined}
        >
          {item.toUpperCase()}
        </a>
      ))}
    </div>

    <button class="theme-toggle" type="button" aria-label={t.themeLabel}>
      <Sun class="sun-icon" />
      <Moon class="moon-icon" />
    </button>
    <button
      class="menu-toggle"
      type="button"
      aria-label={t.menuLabel}
      aria-expanded="false"
      aria-controls="nav-list"
    >
      <Menu class="menu-icon" />
      <X class="close-icon" />
    </button>
  </div>
</nav>

<script>
  const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const navList = document.querySelector<HTMLUListElement>('.nav-list');

  themeToggle?.addEventListener('click', () => {
    const currentTheme = document.documentElement.getAttribute('data-theme');
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', newTheme);

    try {
      localStorage.setItem('theme', newTheme);
    } catch {
      // Without storage access the choice only lasts for the current page
    }
  });

  menuToggle?.addEventListener('click', () => {
    const isOpen = navList?.classList.toggle('is-open') ?? false;
    menuToggle.setAttribute('aria-expanded', String(isOpen));
  });
</script>
