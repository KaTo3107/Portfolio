{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "files": [
    "NetscriptDefinitions.d.ts",
    "NetscriptGlobals.d.ts"
  ],
  "compilerOptions": {
    "jsx": "react",
    "paths": {
      "@ns": [
        "NetscriptDefinitions.d.ts"
      ],
      "@/*": [
        "./*"
      ]
    }
  }
}
